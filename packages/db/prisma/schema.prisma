  LEAD_UPDATED
  APPROVAL_REQUESTED
  APPROVAL_APPROVED
  APPROVAL_REJECTED
  QUOTE_ACCEPTED
  ORDER_CREATED
  GENERAL
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(GENERAL)
  title     String
  message   String
  isRead    Boolean          @default(false) @map("is_read")
  link      String?
  createdAt DateTime         @default(now()) @map("created_at")
  readAt    DateTime?        @map("read_at")

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

// ============================================
// KPT — CHANNEL PARTNERS & INCENTIVES MODULE
// ============================================

enum PartnerType {
  DISTRIBUTOR
  DEALER
  RETAILER
}

enum PartnerTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum PartnerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum IncentiveStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  PAID
  REJECTED
}

enum StockStatus {
  HEALTHY
  LOW
  CRITICAL
  OUT_OF_STOCK
}

model ChannelPartner {
  id                 Int           @id @default(autoincrement())
  code               String        @unique
  name               String
  type               PartnerType
  tier               PartnerTier   @default(BRONZE)
  status             PartnerStatus @default(ACTIVE)
  contactName        String        @map("contact_name")
  contactEmail       String?       @map("contact_email")
  contactPhone       String        @map("contact_phone")
  city               String
  state              String
  region             String?
  gstin              String?
  creditLimit        Float         @default(0) @map("credit_limit")
  outstandingPayment Float         @default(0) @map("outstanding_payment")
  currentMonthSales  Float         @default(0) @map("current_month_sales")
  ytdSales           Float         @default(0) @map("ytd_sales")
  targetAmount       Float         @default(0) @map("target_amount")
  notes              String?
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  incentives   PartnerIncentive[]
  stockEntries StockEntry[]

  @@index([type])
  @@index([tier])
  @@index([status])
  @@map("channel_partners")
}

model IncentiveSlab {
  id               Int         @id @default(autoincrement())
  tier             PartnerTier
  minSaleAmount    Float       @map("min_sale_amount")
  maxSaleAmount    Float?      @map("max_sale_amount")
  incentivePercent Float       @map("incentive_percent")
  description      String?
  isActive         Boolean     @default(true) @map("is_active")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  @@map("incentive_slabs")
}

model PartnerIncentive {
  id               Int             @id @default(autoincrement())
  partnerId        Int             @map("partner_id")
  partner          ChannelPartner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  period           String          // e.g. "2026-07" (YYYY-MM)
  salesAmount      Float           @map("sales_amount")
  incentivePercent Float           @map("incentive_percent")
  incentiveAmount  Float           @map("incentive_amount")
  status           IncentiveStatus @default(PENDING)
  remarks          String?
  approvedAt       DateTime?       @map("approved_at")
  paidAt           DateTime?       @map("paid_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([partnerId])
  @@index([period])
  @@index([status])
  @@map("partner_incentives")
}

model StockEntry {
  id          Int            @id @default(autoincrement())
  partnerId   Int            @map("partner_id")
  partner     ChannelPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  productName String         @map("product_name")
  sku         String
  category    String
  stockQty    Int            @default(0) @map("stock_qty")
  minStockQty Int            @default(10) @map("min_stock_qty")
  reorderQty  Int            @default(20) @map("reorder_qty")
  unitPrice   Float          @map("unit_price")
  stockStatus StockStatus    @default(HEALTHY) @map("stock_status")
  lastUpdated DateTime       @default(now()) @map("last_updated")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([partnerId])
  @@index([sku])
  @@index([stockStatus])
  @@map("stock_entries")
}

model InventoryItem {
  id          Int         @id @default(autoincrement())
  productName String      @map("product_name")
  sku         String      @unique
  category    String
  description String?
  totalQty    Int         @default(0) @map("total_qty")
  minStockQty Int         @default(10) @map("min_stock_qty")
  reorderQty  Int         @default(20) @map("reorder_qty")
  unitPrice   Float       @map("unit_price")
  stockStatus StockStatus @default(HEALTHY) @map("stock_status")
  lastUpdated DateTime    @default(now()) @map("last_updated")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([sku])
  @@index([category])
  @@index([stockStatus])
  @@map("inventory_items")
}
